// --- 1. Pines de los Motores (Puente H L298N) ---
const int PIN_IN1 = 2;
const int PIN_IN2 = 3;
const int PIN_IN3 = 4;
const int PIN_IN4 = 5;

// --- 2. Pines del Sensor Ultrasónico (HC-SR04) ---
const int trigPin = 6;
const int echoPin = 7;

void setup() {
  // Configurar pines de motores como salidas
  pinMode(PIN_IN1, OUTPUT);
  pinMode(PIN_IN2, OUTPUT);
  pinMode(PIN_IN3, OUTPUT);
  pinMode(PIN_IN4, OUTPUT);

  // Configurar pines del sensor ultrasónico
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  Serial.begin(9600);
}

void loop() {
  long distancia = medirDistancia();

  // Si detecta un obstáculo a menos de 20 cm
  if (distancia > 0 && distancia < 20) {
    detenerMotores();
    delay(300); // Breve pausa

    retrocederMotores();
    delay(600); // Retrocede durante medio segundo

    girarDerecha();
    delay(700); // Gira para cambiar de dirección y esquivar
  } 
  else {
    // Si el camino está libre, avanza normal
    avanzarMotores();
  }

  delay(50);
}

// ==========================================
// FUNCIONES DE MOVIMIENTO DE LOS MOTORES
// ==========================================

void avanzarMotores() {
  digitalWrite(PIN_IN1, HIGH);
  digitalWrite(PIN_IN2, LOW);
  digitalWrite(PIN_IN3, HIGH);
  digitalWrite(PIN_IN4, LOW);
}

void detenerMotores() {
  digitalWrite(PIN_IN1, LOW);
  digitalWrite(PIN_IN2, LOW);
  digitalWrite(PIN_IN3, LOW);
  digitalWrite(PIN_IN4, LOW);
}

void retrocederMotores() {
  digitalWrite(PIN_IN1, LOW);
  digitalWrite(PIN_IN2, HIGH);
  digitalWrite(PIN_IN3, LOW);
  digitalWrite(PIN_IN4, HIGH);
}

void girarDerecha() {
  // Un motor gira hacia adelante y el otro hacia atrás para girar sobre su propio eje
  digitalWrite(PIN_IN1, HIGH);
  digitalWrite(PIN_IN2, LOW);
  digitalWrite(PIN_IN3, LOW);
  digitalWrite(PIN_IN4, HIGH);
}

// ==========================================
// FUNCIÓN PARA MEDIR DISTANCIA (ULTRASONIDO)
// ==========================================

long medirDistancia() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  
  long duracion = pulseIn(echoPin, HIGH, 30000); 
  long distanciaCm = duracion * 0.034 / 2;
  
  return distanciaCm;
}
